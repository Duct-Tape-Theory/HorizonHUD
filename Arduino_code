#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Wire.h>

Adafruit_MPU6050 mpu;

float roll = 0, pitch = 0;
unsigned long lastTime;
int debugCounter = 0;

// Mets true pour voir les infos dans l'IDE
// Mets false quand tu utilises Qt
#define MODE_DEBUG true

void setup() {
Serial.begin(115200);
delay(1000);

if (MODE_DEBUG) {
Serial.println("=== Demarrage MPU-9250/9350 ===");
Serial.println("MODE DEBUG ACTIF");
}

Wire.begin();

if (!mpu.begin()) {
Serial.println("ERREUR : capteur non detecte !");
Serial.println("Verifiez : VCC=3.3V, GND, SDA=A4, SCL=A5, AD0=GND");
while (1) { delay(500); }
}

if (MODE_DEBUG) {
Serial.println("Capteur OK !");
Serial.println("================================");
Serial.println(" PITCH | ROLL | AccX | AccY | AccZ");
Serial.println("---------|----------|--------|--------|--------");
} else {
Serial.println("Capteur OK - mode Qt actif");
Serial.println("Format : pitch,roll,altitude");
}

mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
mpu.setGyroRange(MPU6050_RANGE_500_DEG);
mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

lastTime = millis();
}

void loop() {
sensors_event_t a, g, temp;
mpu.getEvent(&a, &g, &temp);

unsigned long now = millis();
float dt = (now - lastTime) / 1000.0;
lastTime = now;

if (dt <= 0 || dt > 1.0) {
delay(20);
return;
}

float rollAcc = atan2(a.acceleration.y, a.acceleration.z) * 180.0 / M_PI;
float pitchAcc = atan2(-a.acceleration.x,
sqrt(a.acceleration.y * a.acceleration.y +
a.acceleration.z * a.acceleration.z)) * 180.0 / M_PI;

roll = 0.96 * (roll + g.gyro.x * dt * 180.0 / M_PI) + 0.04 * rollAcc;
pitch = 0.96 * (pitch + g.gyro.y * dt * 180.0 / M_PI) + 0.04 * pitchAcc;

if (MODE_DEBUG) {
// Affichage tableau lisible dans le moniteur série Arduino
debugCounter++;
if (debugCounter >= 10) { // toutes les 200ms en mode debug
debugCounter = 0;

  // Pitch
  Serial.print("  ");
  if (pitch >= 0) Serial.print(" ");
  Serial.print(pitch, 1);
  Serial.print(" deg");

  Serial.print("  |  ");

  // Roll
  if (roll >= 0) Serial.print(" ");
  Serial.print(roll, 1);
  Serial.print(" deg");

  Serial.print("  |  ");

  // Accéléromètre brut
  Serial.print(a.acceleration.x, 2);
  Serial.print("  |  ");
  Serial.print(a.acceleration.y, 2);
  Serial.print("  |  ");
  Serial.println(a.acceleration.z, 2);
}
} else {
// Mode Qt : envoi compact
Serial.print(pitch, 2);
Serial.print(",");
Serial.print(roll, 2);
Serial.print(",");
Serial.println(0.0, 1);
}

delay(20);
}
